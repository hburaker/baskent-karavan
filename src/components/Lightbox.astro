---
// Tüm sitede ortak görsel büyütme penceresi.
// Kullanım: <a href="/buyuk.webp" data-lb="grup-adi" data-caption="Açıklama"><img .../></a>
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const t = ui[Astro.props.lang];
---
<dialog class="lb" data-lb-dialog aria-label="Galeri">
  <div class="lb-stage">
    <img alt="" data-lb-img />
    <div class="lb-spinner" aria-hidden="true"></div>
  </div>
  <p class="lb-caption"><span data-lb-caption></span> <span class="lb-count" data-lb-count></span></p>
  <button class="lb-btn lb-close" type="button" data-lb-close aria-label={t['lightbox.close']}><Icon name="close" /></button>
  <button class="lb-btn lb-prev" type="button" data-lb-prev aria-label={t['lightbox.prev']}><Icon name="arrow-left" /></button>
  <button class="lb-btn lb-next" type="button" data-lb-next aria-label={t['lightbox.next']}><Icon name="arrow-right" /></button>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb-dialog]')!;
  const im = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
  const cnt = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
  let items: HTMLAnchorElement[] = [];
  let idx = 0;

  const show = (i: number) => {
    idx = (i + items.length) % items.length;
    const a = items[idx];
    dlg.classList.add('loading');
    im.onload = () => dlg.classList.remove('loading');
    im.src = a.href;
    im.alt = a.querySelector('img')?.alt ?? '';
    cap.textContent = a.dataset.caption ?? im.alt;
    cnt.textContent = items.length > 1 ? `${idx + 1} / ${items.length}` : '';
    // komşu görseli önceden yükle
    const n = items[(idx + 1) % items.length];
    if (n) new Image().src = n.href;
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lb]');
    if (!a) return;
    e.preventDefault();
    items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lb="${a.dataset.lb}"]`)].filter((x) => x.offsetParent !== null || x === a);
    show(items.indexOf(a));
    dlg.showModal();
    document.documentElement.style.overflow = 'hidden';
  });
  const close = () => dlg.close();
  dlg.addEventListener('close', () => (document.documentElement.style.overflow = ''));
  dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
  dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
  dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lb-stage')) close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(idx + 1);
    if (e.key === 'ArrowLeft') show(idx - 1);
  });
  let sx = 0;
  dlg.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgb(8 14 12 / 0.96); color: #fff;
  }
  .lb::backdrop { background: rgb(8 14 12 / 0.8); }
  .lb[open] { display: grid; grid-template-rows: 1fr auto; animation: fade 0.25s ease; }
  .lb-stage { position: relative; display: grid; place-items: center; padding: 64px 72px 8px; min-height: 0; }
  .lb-stage img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; transition: opacity 0.2s; }
  .lb.loading img { opacity: 0.35; }
  .lb-spinner { position: absolute; width: 40px; height: 40px; border-radius: 50%; border: 3px solid rgb(255 255 255 / 0.2); border-top-color: var(--ochre-400); animation: spin 0.8s linear infinite; opacity: 0; }
  .lb.loading .lb-spinner { opacity: 1; }
  .lb-caption { text-align: center; padding: 12px 16px 22px; margin: 0; font-weight: 600; color: rgb(255 255 255 / 0.85); }
  .lb-count { color: var(--ochre-400); margin-left: 8px; font-variant-numeric: tabular-nums; }
  .lb-btn { position: absolute; width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.2); background: rgb(255 255 255 / 0.08); color: #fff; display: grid; place-items: center; transition: background 0.2s; }
  .lb-btn:hover { background: var(--ochre-400); color: var(--ink); }
  .lb-close { top: 14px; right: 14px; }
  .lb-prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 14px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lb-stage { padding: 64px 8px 8px; }
    .lb-prev, .lb-next { top: auto; bottom: 64px; transform: none; }
  }
  @keyframes fade { from { opacity: 0; } }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
