---
// Hafif YouTube oynatıcı: sayfa açılışında iframe yüklenmez, tıklanınca yüklenir (hız + gizlilik).
import Icon from './Icon.astro';
interface Props { id: string; title: string; poster?: string; label?: string; class?: string }
const { id, title, poster, label = 'Play', class: cls } = Astro.props;
const thumb = poster ?? `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<div class:list={['yt', cls]} data-yt={id} data-title={title}>
  <img src={thumb} alt={title} loading="lazy" width="480" height="360" />
  <button type="button" class="yt-play" aria-label={`${label}: ${title}`}>
    <Icon name="play-fill" />
  </button>
</div>

<script>
  document.addEventListener('click', (e) => {
    const box = (e.target as HTMLElement).closest<HTMLElement>('[data-yt]');
    if (!box || box.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0&modestbranding=1`;
    f.title = box.dataset.title ?? 'YouTube';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    f.allowFullscreen = true;
    box.append(f);
    box.classList.add('is-playing');
  });
</script>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: #000; cursor: pointer; }
  .yt img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.3s; }
  .yt:hover img { transform: scale(1.04); opacity: 0.85; }
  .yt::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgb(0 0 0 / 0.45)); pointer-events: none; }
  .yt-play {
    position: absolute; z-index: 2; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 76px; height: 76px; border-radius: 50%; border: 0; background: var(--ochre-400); color: var(--ink);
    display: grid; place-items: center; box-shadow: 0 0 0 10px rgb(232 173 69 / 0.25); transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .yt-play :global(svg) { width: 30px; height: 30px; margin-left: 4px; }
  .yt:hover .yt-play { transform: translate(-50%, -50%) scale(1.08); box-shadow: 0 0 0 16px rgb(232 173 69 / 0.2); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 3; }
  .yt.is-playing::after, .yt.is-playing .yt-play { display: none; }
</style>
