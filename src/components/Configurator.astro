---
// Karavan yapılandırıcı: model + ekstra seçimi, canlı fiyat, WhatsApp'a hazır mesaj.
// Fiyatlar: src/data/products.ts (model) ve src/data/extras.ts (ekstralar).
import Icon from './Icon.astro';
import { products, img } from '../data/products';
import { extras, type ExtraGroup } from '../data/extras';
import { site } from '../data/site';
import { ui, langMeta, formatPrice, productUrl, type Lang } from '../i18n/ui';

interface Props { lang: Lang; initial?: string; syncUrl?: boolean }
const { lang, initial = 'prime-400', syncUrl = false } = Astro.props;
const t = ui[lang];
const groups: ExtraGroup[] = ['energy', 'comfort', 'chassis', 'outdoor'];

const data = {
  lang,
  locale: langMeta[lang].locale,
  wa: site.whatsapp,
  syncUrl,
  origin: site.url,
  products: products.map((p) => ({ slug: p.slug, name: p.name, price: p.price, url: productUrl(lang, p.slug) })),
  extras: extras.map((x) => ({ id: x.id, price: x.price, std: x.standardOn, name: x.name[lang] })),
  s: {
    hello: t['wa.hello'], model: t['wa.model'], extras: t['wa.extras'], noExtras: t['wa.noExtras'], total: t['wa.total'],
    name: t['wa.name'], city: t['wa.city'], vat: t['price.vat'], none: t['price.none'], standard: t['price.standard'], selected: t['cfg.selectedCount'],
  },
};
---
<div class="cfg" data-cfg>
  <script type="application/json" data-cfg-data set:html={JSON.stringify(data)} />

  <div class="cfg-main">
    <!-- 1. Model -->
    <fieldset class="cfg-step">
      <legend><span class="step-no">1</span> {t['cfg.step1']}</legend>
      <div class="models">
        {products.map((p) => (
          <label class="model">
            <input type="radio" name="cfg-model" value={p.slug} checked={p.slug === initial} />
            <span class="model-img"><img src={img(p.slug, 'ext', p.hero, true)} alt="" width="320" height="180" loading="lazy" /></span>
            <span class="model-name">{p.name}</span>
            <span class="model-price">{formatPrice(p.price, lang)}</span>
            <span class="model-check"><Icon name="check" size={16} /></span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- 2. Ekstralar -->
    <fieldset class="cfg-step">
      <legend><span class="step-no">2</span> {t['cfg.step2']}</legend>
      {groups.map((g) => (
        <div class="xgroup">
          <p class="xgroup-title">{t[`cfg.group.${g}` as const]}</p>
          <div class="xgrid">
            {extras.filter((x) => x.group === g).map((x) => (
              <label class="x" data-x={x.id}>
                <input type="checkbox" value={x.id} />
                <span class="x-icon"><Icon name={x.icon} /></span>
                <span class="x-text">
                  <span class="x-name">{x.name[lang]}</span>
                  <span class="x-desc">{x.desc[lang]}</span>
                </span>
                <span class="x-side">
                  <span class="x-price">+{formatPrice(x.price, lang)}</span>
                  <span class="x-std">{t['price.standard']}</span>
                  <span class="x-toggle" aria-hidden="true"><Icon name="plus" size={16} /><Icon name="check" size={16} /></span>
                </span>
              </label>
            ))}
          </div>
        </div>
      ))}
    </fieldset>
  </div>

  <!-- 3. Özet -->
  <aside class="cfg-summary" id="teklif-ozeti" aria-live="polite">
    <div class="sum-card">
      <p class="sum-kicker">{t['cfg.summary']}</p>
      <div class="sum-model">
        <img src={img(initial, 'ext', products.find((p) => p.slug === initial)?.hero ?? 1, true)} alt="" width="320" height="180" data-sum-img />
        <div>
          <a class="sum-name" data-sum-name href="#"></a>
          <p class="sum-base"><span>{t['price.base']}</span> <b data-sum-base></b></p>
        </div>
      </div>
      <div class="sum-extras">
        <p class="sum-sub"><span>{t['price.extras']}</span> <button type="button" class="sum-reset" data-reset><Icon name="reset" size={14} /> {t['cfg.reset']}</button></p>
        <ul data-sum-list></ul>
      </div>
      <div class="sum-total">
        <span>{t['price.total']} <small>{t['price.vat']}</small></span>
        <strong data-sum-total></strong>
      </div>
      <div class="sum-fields">
        <label><span>{t['cfg.name']} <em>({t['cfg.optional']})</em></span><input type="text" data-f-name autocomplete="name" maxlength="60" /></label>
        <label><span>{t['cfg.city']} <em>({t['cfg.optional']})</em></span><input type="text" data-f-city autocomplete="address-level2" maxlength="60" /></label>
      </div>
      <a class="btn btn--wa btn--lg btn--block" data-wa href="#" target="_blank" rel="noopener"><Icon name="whatsapp" /> {t['cta.quote']}</a>
      <p class="sum-note">{t['cfg.disclaimer']}</p>
    </div>
  </aside>

  <!-- Mobilde altta sabit özet çubuğu -->
  <div class="cfg-bar" data-cfg-bar>
    <div><small data-bar-count></small><strong data-bar-total></strong></div>
    <a href="#teklif-ozeti" class="btn btn--primary">{t['cfg.viewSummary']} <Icon name="arrow-right" /></a>
  </div>
</div>

<script>
  type Data = {
    lang: string; locale: string; wa: string; syncUrl: boolean; origin: string;
    products: { slug: string; name: string; price: number; url: string }[];
    extras: { id: string; price: number; std: string[]; name: string }[];
    s: Record<string, string>;
  };

  document.querySelectorAll<HTMLElement>('[data-cfg]').forEach((root) => {
    const D: Data = JSON.parse(root.querySelector('[data-cfg-data]')!.textContent!);
    const fmt = (n: number) => `${new Intl.NumberFormat(D.locale).format(Math.round(n))} TL`;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const modelInputs = [...root.querySelectorAll<HTMLInputElement>('input[name="cfg-model"]')];
    const xLabels = [...root.querySelectorAll<HTMLLabelElement>('[data-x]')];
    const selected = new Set<string>();
    let model = modelInputs.find((i) => i.checked)?.value ?? D.products[0].slug;
    let shownTotal = 0;
    let raf = 0;

    // URL'den başlangıç durumu (?model=prime-400&x=ac,tv)
    if (D.syncUrl) {
      const q = new URLSearchParams(location.search);
      const m = q.get('model');
      if (m && D.products.some((p) => p.slug === m)) model = m;
      (q.get('x') ?? '').split(',').filter(Boolean).forEach((id) => D.extras.some((x) => x.id === id) && selected.add(id));
    }

    const animateTo = (target: number, el: HTMLElement, el2: HTMLElement) => {
      cancelAnimationFrame(raf);
      const start = shownTotal, t0 = performance.now(), dur = 550;
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        const v = start + (target - start) * (1 - Math.pow(1 - k, 3));
        el.textContent = fmt(v); el2.textContent = fmt(v);
        shownTotal = v;
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
      el.parentElement?.classList.remove('bump'); void el.offsetWidth; el.parentElement?.classList.add('bump');
    };

    const render = () => {
      const p = D.products.find((x) => x.slug === model)!;
      modelInputs.forEach((i) => (i.checked = i.value === model));

      // Standart olanları işaretle, seçimden çıkar
      xLabels.forEach((l) => {
        const x = D.extras.find((e) => e.id === l.dataset.x)!;
        const std = x.std.includes(model);
        const input = l.querySelector('input')!;
        if (std) selected.delete(x.id);
        l.classList.toggle('is-std', std);
        input.disabled = std;
        input.checked = std || selected.has(x.id);
        l.classList.toggle('is-on', !std && selected.has(x.id));
      });

      const chosen = D.extras.filter((x) => selected.has(x.id));
      const total = p.price + chosen.reduce((a, x) => a + x.price, 0);

      const img = $<HTMLImageElement>('[data-sum-img]');
      const card = modelInputs.find((i) => i.value === model)?.closest('label')?.querySelector('img');
      if (card) img.src = card.src;
      const nameEl = $<HTMLAnchorElement>('[data-sum-name]');
      nameEl.textContent = p.name; nameEl.href = p.url;
      $('[data-sum-base]').textContent = fmt(p.price);

      const list = $('[data-sum-list]');
      list.innerHTML = chosen.length
        ? chosen.map((x) => `<li><span>${x.name}</span><b>+${fmt(x.price)}</b><button type="button" data-rm="${x.id}" aria-label="×">×</button></li>`).join('')
        : `<li class="empty">${D.s.none}</li>`;

      animateTo(total, $('[data-sum-total]'), $('[data-bar-total]'));
      $('[data-bar-count]').textContent = `${p.name} · ${chosen.length} ${D.s.selected}`;

      // WhatsApp mesajı
      const name = $<HTMLInputElement>('[data-f-name]').value.trim();
      const city = $<HTMLInputElement>('[data-f-city]').value.trim();
      const lines = [
        D.s.hello,
        '',
        `🚐 ${D.s.model}: ${p.name} — ${fmt(p.price)}`,
        '',
        `➕ ${D.s.extras}:`,
        ...(chosen.length ? chosen.map((x) => `• ${x.name} — ${fmt(x.price)}`) : [`• ${D.s.noExtras}`]),
        '',
        `💰 ${D.s.total}: ${fmt(total)} (${D.s.vat})`,
      ];
      if (name || city) lines.push('', ...(name ? [`${D.s.name}: ${name}`] : []), ...(city ? [`${D.s.city}: ${city}`] : []));
      const share = new URL(location.pathname, location.origin);
      share.searchParams.set('model', model);
      if (chosen.length) share.searchParams.set('x', chosen.map((x) => x.id).join(','));
      lines.push('', share.href.replace(/%2C/g, ','));
      $<HTMLAnchorElement>('[data-wa]').href = `https://wa.me/${D.wa}?text=${encodeURIComponent(lines.join('\n'))}`;

      if (D.syncUrl) history.replaceState(null, '', `${location.pathname}${share.search.replace(/%2C/g, ',')}${location.hash}`);
    };

    modelInputs.forEach((i) => i.addEventListener('change', () => { model = i.value; render(); }));
    xLabels.forEach((l) =>
      l.querySelector('input')!.addEventListener('change', (e) => {
        const inp = e.target as HTMLInputElement;
        inp.checked ? selected.add(inp.value) : selected.delete(inp.value);
        render();
      }),
    );
    root.addEventListener('click', (e) => {
      const rm = (e.target as HTMLElement).closest<HTMLElement>('[data-rm]');
      if (rm) { selected.delete(rm.dataset.rm!); render(); }
    });
    $('[data-reset]').addEventListener('click', () => { selected.clear(); render(); });
    root.querySelectorAll('[data-f-name],[data-f-city]').forEach((i) => i.addEventListener('input', render));

    // Mobil alt çubuk: yapılandırıcı görünürken göster, özet görünürken gizle
    const bar = $('[data-cfg-bar]');
    const summary = $('.cfg-summary');
    let inCfg = false, inSum = false;
    const upd = () => {
      bar.classList.toggle('show', inCfg && !inSum);
      document.body.classList.toggle('cfg-active', inCfg);
    };
    new IntersectionObserver(([e]) => { inCfg = e.isIntersecting; upd(); }, { rootMargin: '-30% 0px -30% 0px' }).observe(root);
    new IntersectionObserver(([e]) => { inSum = e.isIntersecting; upd(); }, { threshold: 0.15 }).observe(summary);

    render();
  });
</script>

<style>
  .cfg { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: clamp(24px, 3vw, 44px); align-items: start; }
  .cfg-step { border: 0; padding: 0; margin: 0 0 40px; min-width: 0; }
  .cfg-step legend { display: flex; align-items: center; gap: 12px; font-size: 1.35rem; font-weight: 800; margin-bottom: 18px; padding: 0; letter-spacing: -0.02em; }
  .step-no { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--forest-900); color: var(--ochre-400); font-size: 0.95rem; }

  .models { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .model {
    position: relative; display: grid; gap: 2px; padding: 10px 10px 14px; border-radius: var(--radius); background: var(--white);
    border: 2px solid var(--line); cursor: pointer; transition: border-color 0.2s, box-shadow 0.25s, transform 0.25s var(--ease);
  }
  .model:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .model input { position: absolute; opacity: 0; pointer-events: none; }
  .model-img { aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; margin-bottom: 8px; background: var(--sand-100); }
  .model-img img { width: 100%; height: 100%; object-fit: cover; }
  .model-name { font-weight: 800; padding: 0 4px; }
  .model-price { font-size: 0.86rem; color: var(--muted); font-weight: 600; padding: 0 4px; }
  .model-check { position: absolute; top: 16px; right: 16px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--ochre-400); color: var(--ink); transform: scale(0); transition: transform 0.3s var(--ease); }
  .model:has(input:checked) { border-color: var(--ochre-500); box-shadow: 0 0 0 4px rgb(232 173 69 / 0.2); }
  .model:has(input:checked) .model-check { transform: scale(1); }
  .model:has(input:focus-visible) { outline: 3px solid var(--ochre-400); outline-offset: 2px; }

  .xgroup + .xgroup { margin-top: 26px; }
  .xgroup-title { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ochre-700); margin-bottom: 12px; }
  .xgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .x {
    position: relative; display: grid; grid-template-columns: 48px 1fr auto; gap: 14px; align-items: center; padding: 14px 16px; border-radius: var(--radius);
    background: var(--white); border: 2px solid var(--line); cursor: pointer; transition: border-color 0.2s, background 0.2s, box-shadow 0.25s;
  }
  .x:hover { border-color: var(--sand-300); box-shadow: var(--shadow-sm); }
  .x input { position: absolute; opacity: 0; pointer-events: none; }
  .x:has(input:focus-visible) { outline: 3px solid var(--ochre-400); outline-offset: 2px; }
  .x-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--sand-100); color: var(--forest-700); transition: background 0.2s, color 0.2s; }
  .x-icon :global(svg) { width: 24px; height: 24px; }
  .x-text { display: grid; gap: 2px; min-width: 0; }
  .x-name { font-weight: 800; font-size: 0.98rem; line-height: 1.3; }
  .x-desc { font-size: 0.82rem; color: var(--muted); line-height: 1.4; }
  .x-side { display: grid; justify-items: end; gap: 6px; }
  .x-price { font-weight: 800; font-size: 0.9rem; white-space: nowrap; color: var(--forest-700); }
  .x-std { display: none; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 8px; border-radius: 999px; background: var(--forest-900); color: var(--ochre-300); }
  .x-toggle { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid var(--sand-300); color: var(--muted); transition: all 0.2s; }
  .x-toggle :global(svg:last-child) { display: none; }
  .x.is-on { border-color: var(--ochre-500); background: #fffaf0; }
  .x.is-on .x-icon { background: var(--ochre-400); color: var(--ink); }
  .x.is-on .x-toggle { background: var(--ochre-400); border-color: var(--ochre-400); color: var(--ink); }
  .x.is-on .x-toggle :global(svg:first-child) { display: none; }
  .x.is-on .x-toggle :global(svg:last-child) { display: block; }
  .x.is-std { cursor: default; background: var(--sand-100); border-style: dashed; }
  .x.is-std .x-price, .x.is-std .x-toggle { display: none; }
  .x.is-std .x-std { display: inline-block; }
  .x.is-std .x-icon { background: var(--forest-900); color: var(--ochre-300); }

  .cfg-summary { position: sticky; top: calc(var(--header-h) + 20px); }
  .sum-card { background: var(--forest-900); color: var(--sand-100); border-radius: var(--radius-lg); padding: 26px; box-shadow: var(--shadow-lg); }
  .sum-kicker { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ochre-400); margin-bottom: 16px; }
  .sum-model { display: grid; grid-template-columns: 112px 1fr; gap: 14px; align-items: center; padding-bottom: 18px; border-bottom: 1px solid rgb(255 255 255 / 0.1); }
  .sum-model img { border-radius: 12px; aspect-ratio: 16/10; object-fit: cover; width: 100%; }
  .sum-name { font-size: 1.35rem; font-weight: 800; color: var(--white); display: block; }
  .sum-name:hover { color: var(--ochre-300); }
  .sum-base { margin: 2px 0 0; font-size: 0.9rem; color: rgb(243 237 226 / 0.7); display: flex; gap: 8px; flex-wrap: wrap; }
  .sum-base b { color: var(--sand-50); }
  .sum-extras { padding: 16px 0; border-bottom: 1px solid rgb(255 255 255 / 0.1); }
  .sum-sub { display: flex; justify-content: space-between; align-items: center; font-size: 0.86rem; font-weight: 700; color: rgb(243 237 226 / 0.7); margin-bottom: 8px; }
  .sum-reset { display: inline-flex; align-items: center; gap: 4px; background: none; border: 0; color: var(--ochre-300); font-size: 0.82rem; font-weight: 700; padding: 4px; }
  .sum-extras ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; max-height: 240px; overflow: auto; }
  .sum-extras :global(li) { display: grid; grid-template-columns: 1fr auto 24px; gap: 8px; align-items: center; font-size: 0.9rem; animation: slidein 0.35s var(--ease); }
  .sum-extras :global(li b) { white-space: nowrap; color: var(--ochre-300); font-weight: 700; }
  .sum-extras :global(li button) { width: 24px; height: 24px; border-radius: 50%; border: 0; background: rgb(255 255 255 / 0.08); color: var(--sand-100); line-height: 1; }
  .sum-extras :global(li button:hover) { background: #c0392b; }
  .sum-extras :global(li.empty) { display: block; color: rgb(243 237 226 / 0.5); font-style: italic; }
  .sum-total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 0; flex-wrap: wrap; }
  .sum-total span { font-weight: 700; }
  .sum-total small { display: block; font-size: 0.75rem; color: rgb(243 237 226 / 0.55); font-weight: 600; }
  .sum-total strong { font-size: clamp(1.8rem, 3vw, 2.2rem); font-weight: 800; color: var(--ochre-400); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .sum-total.bump strong { animation: bump 0.45s var(--ease); }
  .sum-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
  .sum-fields label { display: grid; gap: 4px; font-size: 0.78rem; font-weight: 700; color: rgb(243 237 226 / 0.75); }
  .sum-fields em { font-style: normal; font-weight: 500; opacity: 0.7; }
  .sum-fields input { height: 44px; border-radius: 12px; border: 1px solid rgb(255 255 255 / 0.15); background: rgb(255 255 255 / 0.06); color: #fff; padding: 0 12px; font: inherit; font-size: 0.95rem; min-width: 0; }
  .sum-fields input:focus { outline: 2px solid var(--ochre-400); border-color: transparent; }
  .sum-note { font-size: 0.78rem; color: rgb(243 237 226 / 0.55); margin: 14px 0 0; line-height: 1.5; }

  .cfg-bar { display: none; }

  @keyframes bump { 40% { transform: scale(1.06); } }
  @keyframes slidein { from { opacity: 0; transform: translateX(-8px); } }

  @media (max-width: 1100px) {
    .cfg { grid-template-columns: 1fr; }
    .cfg-summary { position: static; }
    .sum-card { max-width: 640px; margin-inline: auto; }
  }
  @media (max-width: 760px) {
    .models { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xgrid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .x { grid-template-columns: 40px 1fr auto; gap: 12px; padding: 12px; }
    .x-icon { width: 40px; height: 40px; border-radius: 12px; }
    .sum-fields { grid-template-columns: 1fr; }
    .sum-card { padding: 20px; }
    .cfg-bar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 95; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: var(--forest-950); color: var(--sand-50);
      transform: translateY(110%); transition: transform 0.35s var(--ease); box-shadow: 0 -10px 30px rgb(0 0 0 / 0.25);
    }
    .cfg-bar.show { transform: none; }
    .cfg-bar div { display: grid; min-width: 0; }
    .cfg-bar small { font-size: 0.75rem; color: rgb(243 237 226 / 0.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cfg-bar strong { font-size: 1.25rem; color: var(--ochre-400); font-variant-numeric: tabular-nums; }
    .cfg-bar .btn { min-height: 46px; padding: 0 16px; }
    :global(body.cfg-active [data-fab]) { transform: translateY(120%); }
  }
  :global([data-fab]) { transition: transform 0.35s var(--ease); }
</style>
