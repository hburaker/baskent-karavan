---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { products, img } from '../data/products';
import { ui, url, productUrl, formatPrice, type Lang, type RouteKey } from '../i18n/ui';

interface Props { lang: Lang; alternates: Record<Lang, string>; current?: RouteKey | 'product' | 'post'; transparent?: boolean }
const { lang, alternates, current, transparent = false } = Astro.props;
const t = ui[lang];

const links: { key: RouteKey; label: string; href: string }[] = [
  { key: 'configure', label: t['nav.configure'], href: url(lang, 'configure') },
  { key: 'events', label: t['nav.events'], href: url(lang, 'events') },
  { key: 'faq', label: t['nav.faq'], href: url(lang, 'faq') },
  ...(lang === 'tr' ? [{ key: 'blog' as RouteKey, label: t['nav.blog'], href: url(lang, 'blog') }] : []),
  { key: 'contact', label: t['nav.contact'], href: url(lang, 'contact') },
];
const modelsActive = current === 'models' || current === 'product';
---
<header class:list={['site-header', { 'is-transparent': transparent }]} data-header>
  <div class="container header-inner">
    <a href={url(lang, 'home')} class="brand" aria-label="Başkent Karavan">
      <img src="/images/misc/logo-96.png" alt="" width="48" height="48" />
      <span class="brand-text"><strong>BAŞKENT</strong><span>KARAVAN A.Ş.</span></span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Ana menü" data-nav>
      <ul class="nav-list">
        <li class="has-mega">
          <a href={url(lang, 'models')} class:list={['nav-link', { active: modelsActive }]} aria-haspopup="true">
            {t['nav.models']} <Icon name="chevron-down" class="chev" size={16} />
          </a>
          <div class="mega">
            <div class="mega-grid">
              {products.map((p) => (
                <a href={productUrl(lang, p.slug)} class="mega-item">
                  <span class="mega-img"><img src={img(p.slug, 'ext', p.hero, true)} alt={p.name} loading="lazy" width="240" height="135" /></span>
                  <span class="mega-name">{p.name}</span>
                  <span class="mega-price">{formatPrice(p.price, lang)}</span>
                </a>
              ))}
            </div>
            <div class="mega-foot">
              <a href={url(lang, 'models')} class="link-arrow">{t['cta.viewAll']} <Icon name="arrow-right" /></a>
              <a href={url(lang, 'configure')} class="link-arrow">{t['cta.configure']} <Icon name="arrow-right" /></a>
            </div>
          </div>
        </li>
        {links.map((l) => (
          <li><a href={l.href} class:list={['nav-link', { active: current === l.key }]}>{l.label}</a></li>
        ))}
      </ul>

      <div class="nav-mobile-models">
        <p class="nav-mobile-title">{t['nav.models']}</p>
        <div class="nav-mobile-grid">
          {products.map((p) => (
            <a href={productUrl(lang, p.slug)}>
              <img src={img(p.slug, 'ext', p.hero, true)} alt="" loading="lazy" width="160" height="90" />
              <span>{p.name}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <LangSwitch lang={lang} alternates={alternates} />
      <a href={url(lang, 'configure')} class="btn btn--primary header-cta">
        <Icon name="sliders" /> <span>{t['cta.calc']}</span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={t['nav.menu']} data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 30);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toggle.addEventListener('click', () => {
    const open = header.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });
  document.querySelectorAll('[data-nav] a').forEach((a) =>
    a.addEventListener('click', () => {
      header.classList.remove('menu-open');
      document.documentElement.style.overflow = '';
    }),
  );
</script>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100; height: var(--header-h);
    color: var(--text); transition: color 0.3s, transform 0.3s;
  }
  /* Arka planı pseudo-elemana veriyoruz: backdrop-filter header'a verilirse içindeki fixed menüyü bozar */
  .site-header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgb(250 247 241 / 0.86); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid rgb(13 22 19 / 0.07); transition: opacity 0.3s, background 0.3s;
  }
  .site-header.is-transparent { color: var(--white); }
  .site-header.is-transparent::before { opacity: 0; }
  .site-header.is-transparent.is-scrolled { color: var(--text); }
  .site-header.is-transparent.is-scrolled::before { opacity: 1; }

  .header-inner { height: 100%; display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 12px; flex: none; }
  .brand img { width: 48px; height: 48px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 2px rgb(255 255 255 / 0.6); }
  .brand-text { display: flex; flex-direction: column; line-height: 1; }
  .brand-text strong { font-size: 1.12rem; font-weight: 800; letter-spacing: 0.08em; }
  .brand-text span { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.28em; opacity: 0.7; margin-top: 4px; }

  .nav { margin-left: auto; }
  .nav-list { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 4px; padding: 10px 14px; border-radius: 999px;
    font-weight: 700; font-size: 0.94rem; transition: background 0.2s, color 0.2s;
  }
  .nav-link:hover, .nav-link.active { background: rgb(13 22 19 / 0.07); }
  .is-transparent:not(.is-scrolled) .nav-link:hover,
  .is-transparent:not(.is-scrolled) .nav-link.active { background: rgb(255 255 255 / 0.14); }
  .nav-link :global(.chev) { transition: transform 0.25s; }

  .has-mega { position: relative; }
  .mega {
    position: absolute; top: calc(100% + 14px); left: 50%; width: min(760px, 90vw);
    transform: translate(-50%, 8px); opacity: 0; visibility: hidden; pointer-events: none;
    background: var(--white); color: var(--text); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    padding: 18px; transition: opacity 0.25s, transform 0.3s var(--ease), visibility 0.25s;
  }
  .mega::before { content: ''; position: absolute; inset: -16px 0 auto; height: 16px; }
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: translate(-50%, 0); pointer-events: auto; }
  .has-mega:hover :global(.chev) { transform: rotate(180deg); }
  .mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .mega-item { display: grid; gap: 2px; padding: 8px; border-radius: 14px; transition: background 0.2s; }
  .mega-item:hover { background: var(--sand-100); }
  .mega-img { aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; background: var(--sand-100); margin-bottom: 6px; }
  .mega-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .mega-item:hover .mega-img img { transform: scale(1.06); }
  .mega-name { font-weight: 800; }
  .mega-price { font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .mega-foot { display: flex; justify-content: space-between; gap: 16px; padding: 14px 8px 2px; border-top: 1px solid var(--line); margin-top: 10px; flex-wrap: wrap; }

  .nav-mobile-models { display: none; }

  .header-actions { display: flex; align-items: center; gap: 10px; }
  .header-cta { min-height: 44px; padding: 0 18px; font-size: 0.9rem; }
  .header-cta :global(svg) { width: 18px; height: 18px; }

  .menu-toggle { display: none; width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid currentColor; background: transparent; color: inherit; position: relative; }
  .menu-toggle span { position: absolute; left: 13px; right: 13px; height: 2px; background: currentColor; border-radius: 2px; transition: transform 0.3s var(--ease), opacity 0.2s, top 0.3s var(--ease); }
  .menu-toggle span:nth-child(1) { top: 16px; }
  .menu-toggle span:nth-child(2) { top: 22px; }
  .menu-toggle span:nth-child(3) { top: 28px; right: 19px; }
  .menu-open .menu-toggle span:nth-child(1) { top: 22px; transform: rotate(45deg); }
  .menu-open .menu-toggle span:nth-child(2) { opacity: 0; }
  .menu-open .menu-toggle span:nth-child(3) { top: 22px; right: 13px; transform: rotate(-45deg); }

  @media (max-width: 1100px) {
    .header-cta span { display: none; }
    .header-cta { width: 44px; padding: 0; }
    .nav-link { padding: 10px 10px; font-size: 0.9rem; }
  }
  @media (max-width: 960px) {
    .menu-toggle { display: inline-block; }
    .header-cta { display: none; }
    .nav {
      position: absolute; top: 100%; left: 0; right: 0; height: calc(100dvh - var(--header-h));
      background: var(--forest-950); color: var(--sand-50); overflow-y: auto; padding: 18px 16px 40px;
      opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity 0.3s, transform 0.35s var(--ease), visibility 0.3s;
    }
    .menu-open .nav { opacity: 1; visibility: visible; transform: none; }
    .menu-open { color: var(--sand-50) !important; }
    .menu-open::before { opacity: 1 !important; background: var(--forest-950) !important; border-color: rgb(255 255 255 / 0.08) !important; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 2px; }
    .nav-link { font-size: 1.35rem; padding: 14px 6px; border-radius: 0; border-bottom: 1px solid rgb(255 255 255 / 0.08); width: 100%; justify-content: space-between; }
    .nav-link:hover, .nav-link.active { background: transparent; color: var(--ochre-400); }
    .nav-link :global(.chev) { display: none; }
    .mega { display: none; }
    .nav-mobile-models { display: block; margin-top: 28px; }
    .nav-mobile-title { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ochre-400); }
    .nav-mobile-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .nav-mobile-grid a { display: grid; gap: 6px; font-weight: 700; font-size: 0.92rem; }
    .nav-mobile-grid img { border-radius: 12px; aspect-ratio: 16/9; object-fit: cover; width: 100%; }
    .brand-text span { letter-spacing: 0.2em; }
  }
  @media (max-width: 400px) {
    .brand-text strong { font-size: 1rem; }
    .brand img { width: 42px; height: 42px; }
  }
</style>
