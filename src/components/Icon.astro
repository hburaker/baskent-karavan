const isFill = fill || name in F;
const body = F[name] ?? P[name] ?? P['sparkle'];
const s = size ?? 24;
---
{isFill ? (
  <svg class={cls} width={s} height={s} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
) : (
  <svg class={cls} width={s} height={s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={body} />
)}
