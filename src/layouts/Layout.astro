---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { langs, langMeta, ui, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Her dil için bu sayfanın adresi (dil değiştirici + hreflang). Yoksa ana sayfalara gider. */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  current?: RouteKey | 'product' | 'post';
  transparentHeader?: boolean;
  waText?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Ana sayfa hariç yol: [{ name, url }] — BreadcrumbList şeması için */
  breadcrumbs?: { name: string; url: string }[];
  ogType?: 'website' | 'article';
  pageType?: 'WebPage' | 'CollectionPage' | 'ContactPage' | 'FAQPage' | 'AboutPage';
}

const { lang, title, description, alternates = {}, image = '/images/products/prime-540/ext-01.webp', current, transparentHeader = false, waText, schema, breadcrumbs = [], ogType = 'website', pageType = 'WebPage' } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} | ${site.name}` : t['meta.title'];
const desc = description ?? t['meta.desc'];
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const alt: Record<Lang, string> = Object.fromEntries(
  langs.map((l) => [l, alternates[l] ?? (l === 'tr' ? '/' : `/${l}/`)]),
) as Record<Lang, string>;
const hasRealAlternates = Object.keys(alternates).length > 1;

const org = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': `${site.url}/#org`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/images/misc/logo-icon.png`,
  image: ogImage,
  telephone: site.phones[0].tel,
  email: site.email,
  slogan: site.slogan,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.district,
    addressRegion: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.lat, longitude: site.lng },
  hasMap: site.mapsUrl,
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:30', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '16:00' },
  ],
  sameAs: [site.social.facebook, site.social.youtube],
};
const homeUrl = new URL(lang === 'tr' ? '/' : `/${lang}/`, site.url).href;
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  description: ui.tr['meta.desc'],
  inLanguage: langs.map((l) => langMeta[l].locale),
  publisher: { '@id': `${site.url}/#org` },
};
const crumbs = [{ name: t['nav.home'], url: homeUrl }, ...breadcrumbs.map((b) => ({ name: b.name, url: new URL(b.url, site.url).href }))];
const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumblist`,
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
};
const webpage = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description: desc,
  inLanguage: langMeta[lang].locale,
  isPartOf: { '@id': `${site.url}/#website` },
  breadcrumb: { '@id': `${canonical}#breadcrumblist` },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
};
const schemas = [org, website, webpage, breadcrumbList, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    {hasRealAlternates && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(alt[l], site.url).href} />)}
    {hasRealAlternates && <link rel="alternate" hreflang="x-default" href={new URL(alt.tr, site.url).href} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#10201b" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={langMeta[lang].og} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    {site.yandexMetricaId && (
      <script is:inline set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${site.yandexMetricaId},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true});`} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'tr' ? 'İçeriğe geç' : lang === 'de' ? 'Zum Inhalt' : lang === 'ru' ? 'К содержанию' : 'Skip to content'}</a>
    <Header lang={lang} alternates={alt} current={current} transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingWhatsApp lang={lang} text={waText} />
    <Lightbox lang={lang} />
    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
