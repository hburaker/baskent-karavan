---
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import YouTube from '../components/YouTube.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { products, img } from '../data/products';
import { extras } from '../data/extras';
import { site } from '../data/site';
import { ui, url, productUrl, formatPrice, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

// Hero slayt gösterisi (eski sitedeki arka plan slaytındaki modeller)
const slides = [
  { slug: 'prime-540', n: 1 },
  { slug: 'prime-400', n: 6 },
  { slug: 'hera-380', n: 1 },
  { slug: 'pixel-260', n: 1 },
  { slug: 'ares-330', n: 2 },
].map((s) => ({ ...s, p: products.find((p) => p.slug === s.slug)! }));

const features = [
  { icon: 'layers', k: 'f1' },
  { icon: 'brake', k: 'f2' },
  { icon: 'sofa', k: 'f3' },
  { icon: 'sun', k: 'f4' },
  { icon: 'award', k: 'f5' },
  { icon: 'headset', k: 'f6' },
] as const;

const interiors = [
  { slug: 'prime-400', n: 2 },
  { slug: 'hera-380', n: 2 },
  { slug: 'prime-540', n: 1 },
  { slug: 'prime-460', n: 1 },
  { slug: 'ares-330', n: 3 },
  { slug: 'pixel-260', n: 1 },
  { slug: 'hera-380', n: 4 },
].map((s) => ({ ...s, name: products.find((p) => p.slug === s.slug)!.name }));

const docs = [
  { f: 'sertifika-1', k: 'docs.iso' },
  { f: 'sertifika-2', k: 'docs.isoEn' },
  { f: 'o1-tip-onay', k: 'docs.o1' },
  { f: 'o2-tip-onay', k: 'docs.o2' },
  { f: 'ares-marka-tescil', k: 'docs.ares' },
  { f: 'hera-marka-tescil', k: 'docs.hera' },
] as const;

const teaserExtras = ['fridge', 'solar', 'gel-battery', 'braked-chassis', 'ac', 'awning'].map((id) => extras.find((x) => x.id === id)!);
const minPrice = Math.min(...products.map((p) => p.price));
---
<!-- ============ HERO ============ -->
<section class="hero" data-hero>
  <div class="hero-slides" aria-hidden="true">
    {slides.map((s, i) => (
      <img src={img(s.slug, 'ext', s.n)} alt="" class:list={['hero-slide', { active: i === 0 }]} width="1920" height="1080"
        loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />
    ))}
  </div>
  <div class="hero-shade"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker"><span class="dot"></span>{t['hero.kicker']}</p>
      <h1 class="h1">{t['hero.title1']}<br /><span class="accent-script text-ochre">{t['hero.title2']}</span></h1>
      <p class="hero-sub">{t['hero.sub']}</p>
      <div class="btn-row">
        <a href={url(lang, 'models')} class="btn btn--primary btn--lg">{t['cta.explore']} <Icon name="arrow-right" /></a>
        <a href={url(lang, 'configure')} class="btn btn--ghost-light btn--lg"><Icon name="sliders" /> {t['cta.configure']}</a>
      </div>
    </div>

    <div class="hero-now">
      {slides.map((s, i) => (
        <a href={productUrl(lang, s.slug)} class:list={['now-card', { active: i === 0 }]} data-now={i}>
          <span class="now-series">{s.p.series}</span>
          <span class="now-name">{s.p.name}</span>
          <span class="now-price">{formatPrice(s.p.price, lang)} <small>{t['price.vat']}</small></span>
          <span class="now-go"><Icon name="arrow-up-right" /></span>
        </a>
      ))}
      <div class="hero-dots" role="tablist">
        {slides.map((s, i) => <button type="button" class:list={{ active: i === 0 }} data-dot={i} aria-label={s.p.name}><span></span></button>)}
      </div>
    </div>
  </div>

  <div class="hero-stats">
    <div class="container stats-inner">
      <div class="stat"><strong>6</strong><span>{t['stats.models']}</span></div>
      <a class="stat" href={site.mapsUrl} target="_blank" rel="noopener">
        <strong>{site.googleRating}<Icon name="star-fill" class="star" /></strong>
        <span>{t['stats.rating']} · {site.googleReviewsLabel} {t['stats.reviews']}</span>
      </a>
      <div class="stat"><strong>O1 · O2</strong><span>{t['stats.approval']}</span></div>
      <div class="stat"><strong>ISO 9001</strong><span>{t['stats.iso']}</span></div>
    </div>
  </div>
</section>

<!-- ============ MODELLER ============ -->
<section class="section" id="modeller">
  <div class="container">
    <div class="section-head section-head--split">
      <div class="reveal">
        <span class="kicker">{t['models.kicker']}</span>
        <h2 class="h2">{t['models.title']}</h2>
        <p class="lead">{t['models.sub']}</p>
      </div>
      <a href={url(lang, 'models')} class="btn btn--ghost reveal">{t['cta.viewAll']} <Icon name="arrow-right" /></a>
    </div>
    <div class="grid models-grid">
      {products.map((p, i) => <ProductCard p={p} lang={lang} delay={i % 3} />)}
    </div>
  </div>
</section>

<!-- ============ YAPILANDIRICI BANDI ============ -->
<section class="section section--dark band">
  <div class="band-bg" aria-hidden="true"></div>
  <div class="container band-inner">
    <div class="band-copy reveal">
      <span class="kicker">{t['band.kicker']}</span>
      <h2 class="h2">{t['band.title']}</h2>
      <p class="lead">{t['band.sub']}</p>
      <a href={url(lang, 'configure')} class="btn btn--primary btn--lg"><Icon name="sliders" /> {t['cta.configure']}</a>
    </div>
    <div class="band-demo reveal" data-delay="2" aria-hidden="true" data-demo>
      <div class="demo-head">
        <img src={img('prime-400', 'ext', 1, true)} alt="" width="160" height="90" loading="lazy" />
        <div><b>Prime 400</b><span>{formatPrice(650000, lang)}</span></div>
      </div>
      <ul class="demo-list">
        {teaserExtras.map((x, i) => (
          <li data-demo-item={i} data-price={x.price}>
            <span class="demo-ico"><Icon name={x.icon} size={18} /></span>
            <span class="demo-name">{x.name[lang]}</span>
            <span class="demo-sw"><span></span></span>
          </li>
        ))}
      </ul>
      <div class="demo-total"><span>{t['price.total']}</span><strong data-demo-total>{formatPrice(650000, lang)}</strong></div>
    </div>
  </div>
</section>

<!-- ============ NEDEN BİZ + HAKKIMIZDA ============ -->
<section class="section" id="hakkimizda">
  <div class="container about-grid">
    <div class="about-media reveal">
      <img src={img('prime-540', 'ext', 4, true)} alt="Başkent Karavan Prime 540" width="720" height="405" loading="lazy" class="about-img-1" />
      <img src={img('prime-400', 'int', 3, true)} alt="Prime 400" width="720" height="405" loading="lazy" class="about-img-2" />
      <div class="about-badge">
        <img src="/images/misc/logo-icon.png" alt="" width="72" height="72" loading="lazy" />
        <span class="accent-script">{site.slogan}</span>
      </div>
    </div>
    <div class="about-copy reveal" data-delay="1">
      <span class="kicker">{t['about.kicker']}</span>
      <h2 class="h2">{t['about.title']}</h2>
      <p class="lead">{t['about.p1']}</p>
      <p class="muted">{t['about.p2']}</p>
    </div>
  </div>

  <div class="container">
    <div class="section-head section-head--center reveal why-head">
      <span class="kicker">{t['why.kicker']}</span>
      <h2 class="h2">{t['why.title']}</h2>
    </div>
    <div class="grid why-grid">
      {features.map((f, i) => (
        <div class="why reveal" data-delay={i % 3}>
          <span class="why-icon"><Icon name={f.icon} /></span>
          <h3>{t[`why.${f.k}.t`]}</h3>
          <p class="muted">{t[`why.${f.k}.d`]}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ İÇ MEKÂN MOZAİĞİ ============ -->
<section class="section section--sand">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">{t['interior.kicker']}</span>
      <h2 class="h2">{t['interior.title']}</h2>
      <p class="lead">{t['interior.sub']}</p>
    </div>
    <div class="mosaic">
      {interiors.map((m, i) => (
        <a href={img(m.slug, 'int', m.n)} data-lb="interior" data-caption={m.name} class:list={['mosaic-item', `m${i + 1}`, 'reveal']} data-delay={i % 4}>
          <img src={img(m.slug, 'int', m.n, true)} alt={`${m.name} — ${t['product.interior']}`} width="720" height="405" loading="lazy" />
          <span class="mosaic-cap">{m.name}<Icon name="expand" size={16} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============ VİDEO ============ -->
<section class="section section--dark video-sec">
  <div class="container video-grid">
    <div class="reveal">
      <span class="kicker">{t['video.kicker']}</span>
      <h2 class="h2">{t['video.title']}</h2>
      <p class="lead">{t['models.sub']}</p>
      <a href={url(lang, 'faq')} class="link-arrow">{t['cta.allVideos']} <Icon name="arrow-right" /></a>
    </div>
    <div class="reveal" data-delay="1">
      <YouTube id={site.videos.allModels} title="Başkent Karavan — Tüm Modeller" label={t['video.play']} poster={img('prime-540', 'ext', 2)} />
    </div>
  </div>
</section>

<!-- ============ BELGELER ============ -->
<section class="section">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="kicker">{t['docs.kicker']}</span>
      <h2 class="h2">{t['docs.title']}</h2>
    </div>
    <div class="docs">
      {docs.map((d, i) => (
        <a href={`/images/docs/${d.f}.webp`} data-lb="docs" data-caption={t[d.k]} class="doc reveal" data-delay={i % 6}>
          <span class="doc-img"><img src={`/images/docs/${d.f}-sm.webp`} alt={t[d.k]} width="300" height="420" loading="lazy" /></span>
          <span class="doc-name">{t[d.k]}</span>
        </a>
      ))}
    </div>

    <a class="reviews reveal" href={site.mapsUrl} target="_blank" rel="noopener">
      <span class="g"><Icon name="google" size={34} /></span>
      <span class="r-score">{site.googleRating}</span>
      <span class="r-stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star-fill" />)}</span>
      <span class="r-text"><b>{t['reviews.title']}</b><span>{site.googleReviewsLabel} {t['reviews.sub']}</span></span>
      <span class="btn btn--dark">{t['reviews.cta']} <Icon name="arrow-up-right" /></span>
    </a>
  </div>
</section>

<!-- ============ DAHA FAZLASI ============ -->
<section class="section section--sand section--tight">
  <div class="container grid more-grid">
    <a href={url(lang, 'events')} class="more reveal">
      <img src="/images/events/camp-karavan-fuar-sm.webp" alt="" width="720" height="595" loading="lazy" />
      <span class="more-body"><Icon name="calendar" /><b>{t['more.events.t']}</b><span>{t['more.events.d']}</span></span>
    </a>
    <a href={url(lang, 'faq')} class="more reveal" data-delay="1">
      <img src={img('prime-400', 'int', 4, true)} alt="" width="720" height="405" loading="lazy" />
      <span class="more-body"><Icon name="play" /><b>{t['more.faq.t']}</b><span>{t['more.faq.d']}</span></span>
    </a>
    <a href={url('tr', 'blog')} class="more reveal" data-delay="2" hreflang="tr">
      <img src="/images/blog/karavan-ev-1.webp" alt="" width="720" height="480" loading="lazy" />
      <span class="more-body"><Icon name="book" /><b>{t['more.blog.t']}</b><span>{t['more.blog.d']}</span></span>
    </a>
  </div>
</section>

<ContactBlock lang={lang} />

<script>
  // Hero slayt gösterisi + "şu an gördüğünüz model" kartı
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLImageElement>('.hero-slide')];
    const cards = [...hero.querySelectorAll<HTMLElement>('[data-now]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let i = 0;
    let timer: number;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      [slides, cards, dots].forEach((arr) => arr.forEach((el, k) => el.classList.toggle('active', k === i)));
      const next = slides[(i + 1) % slides.length];
      if (next.loading === 'lazy') next.loading = 'eager';
    };
    const start = () => { clearInterval(timer); timer = window.setInterval(() => go(i + 1), 6000); };
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.dot)); start(); }));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) start();
  }

  // Yapılandırıcı bandındaki küçük animasyon: ekstralar sırayla açılır, fiyat artar
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  if (demo) {
    const items = [...demo.querySelectorAll<HTMLElement>('[data-demo-item]')];
    const total = demo.querySelector<HTMLElement>('[data-demo-total]')!;
    const base = 650000;
    const locale = document.documentElement.lang === 'tr' ? 'tr-TR' : document.documentElement.lang;
    const fmt = (n: number) => `${new Intl.NumberFormat(locale).format(n)} TL`;
    const order = [0, 3, 1, 4, 2];
    let step = 0, running = false;
    const tick = () => {
      if (step >= order.length) { step = 0; items.forEach((x) => x.classList.remove('on')); }
      else items[order[step++]].classList.add('on');
      const sum = items.filter((x) => x.classList.contains('on')).reduce((a, x) => a + Number(x.dataset.price), base);
      total.textContent = fmt(sum);
      total.classList.remove('bump'); void total.offsetWidth; total.classList.add('bump');
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) { running = true; setInterval(tick, 1400); }
    }, { threshold: 0.4 }).observe(demo);
  }
</script>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; min-height: max(680px, 100svh); display: flex; flex-direction: column; color: var(--white); background: var(--forest-950); overflow: hidden; }
  .hero-slides { position: absolute; inset: 0; }
  .hero-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 60%; opacity: 0; transform: scale(1.08); transition: opacity 1.4s ease, transform 7s linear; }
  .hero-slide.active { opacity: 1; transform: scale(1); }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(11 21 18 / 0.92) 0%, rgb(11 21 18 / 0.7) 38%, rgb(11 21 18 / 0.15) 75%),
      linear-gradient(0deg, rgb(11 21 18 / 0.85) 0%, transparent 35%),
      linear-gradient(180deg, rgb(11 21 18 / 0.55) 0%, transparent 22%);
  }
  .hero-inner { position: relative; z-index: 1; flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-top: calc(var(--header-h) + 40px); padding-bottom: 40px; }
  .hero-copy { max-width: 660px; }
  .hero-kicker { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px; border-radius: 999px; background: rgb(255 255 255 / 0.1); border: 1px solid rgb(255 255 255 / 0.18); font-size: 0.85rem; font-weight: 700; backdrop-filter: blur(6px); margin-bottom: 26px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ochre-400); box-shadow: 0 0 0 4px rgb(232 173 69 / 0.25); }
  .hero h1 { margin-bottom: 24px; animation: rise 1.1s var(--ease) both; }
  .hero h1 .accent-script { font-size: 1.04em; letter-spacing: -0.01em; }
  .hero-sub { font-size: clamp(1.05rem, 1.4vw, 1.22rem); color: rgb(255 255 255 / 0.82); max-width: 560px; margin-bottom: 34px; animation: rise 1.1s 0.12s var(--ease) both; }
  .hero .btn-row { animation: rise 1.1s 0.22s var(--ease) both; }

  .hero-now { position: relative; width: 280px; flex: none; align-self: flex-end; }
  .now-card {
    position: absolute; inset: auto 0 34px 0; display: grid; gap: 2px; padding: 18px 20px; border-radius: 20px;
    background: rgb(255 255 255 / 0.1); border: 1px solid rgb(255 255 255 / 0.2); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity 0.6s, transform 0.6s var(--ease), background 0.2s;
  }
  .now-card.active { opacity: 1; transform: none; pointer-events: auto; position: relative; inset: auto; }
  .now-card:hover { background: rgb(255 255 255 / 0.18); }
  .now-series { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ochre-300); }
  .now-name { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; }
  .now-price { font-weight: 700; color: rgb(255 255 255 / 0.85); }
  .now-price small { font-weight: 600; opacity: 0.7; font-size: 0.75rem; }
  .now-go { position: absolute; top: 16px; right: 16px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--ochre-400); color: var(--ink); }
  .now-go :global(svg) { width: 18px; height: 18px; }
  .hero-dots { display: flex; gap: 8px; margin-top: 14px; }
  .hero-dots button { flex: 1; height: 18px; padding: 0; background: none; border: 0; display: grid; align-items: center; }
  .hero-dots span { display: block; height: 3px; border-radius: 3px; background: rgb(255 255 255 / 0.28); overflow: hidden; position: relative; }
  .hero-dots span::after { content: ''; position: absolute; inset: 0; background: var(--ochre-400); transform: scaleX(0); transform-origin: left; }
  .hero-dots .active span::after { animation: progress 6s linear forwards; }

  .hero-stats { position: relative; z-index: 1; border-top: 1px solid rgb(255 255 255 / 0.12); background: rgb(11 21 18 / 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .stats-inner { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { display: grid; gap: 2px; padding: 22px 20px; border-left: 1px solid rgb(255 255 255 / 0.1); }
  .stat:first-child { border-left: 0; padding-left: 0; }
  .stat strong { font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 800; letter-spacing: -0.02em; display: inline-flex; align-items: center; gap: 6px; }
  .stat :global(.star) { width: 22px; height: 22px; color: var(--ochre-400); }
  .stat span { font-size: 0.82rem; color: rgb(255 255 255 / 0.66); font-weight: 600; }
  a.stat:hover strong { color: var(--ochre-300); }

  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }
  @keyframes progress { to { transform: scaleX(1); } }

  /* ---------- MODELLER ---------- */
  .models-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  /* ---------- BANT ---------- */
  .band { overflow: hidden; }
  .band-bg { position: absolute; inset: 0; background: radial-gradient(800px 400px at 85% 30%, rgb(232 173 69 / 0.16), transparent 60%), radial-gradient(600px 400px at 10% 100%, rgb(61 107 94 / 0.35), transparent 60%); }
  .band-inner { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .band-copy .lead { margin-bottom: 30px; }
  .band-demo { background: var(--sand-50); color: var(--text); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-lg); transform: rotate(1.5deg); }
  .demo-head { display: flex; align-items: center; gap: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .demo-head img { width: 96px; border-radius: 10px; aspect-ratio: 16/10; object-fit: cover; }
  .demo-head div { display: grid; }
  .demo-head span { color: var(--muted); font-size: 0.88rem; }
  .demo-list { list-style: none; margin: 0; padding: 10px 0; display: grid; gap: 6px; }
  .demo-list li { display: grid; grid-template-columns: 34px 1fr 42px; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 12px; transition: background 0.3s; font-weight: 700; font-size: 0.92rem; }
  .demo-list li.on { background: #fff4dd; }
  .demo-ico { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--sand-100); color: var(--forest-700); transition: background 0.3s, color 0.3s; }
  .on .demo-ico { background: var(--ochre-400); color: var(--ink); }
  .demo-sw { width: 42px; height: 24px; border-radius: 999px; background: var(--sand-200); position: relative; transition: background 0.3s; }
  .demo-sw span { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: var(--shadow-sm); transition: transform 0.35s var(--ease); }
  .on .demo-sw { background: var(--forest-700); }
  .on .demo-sw span { transform: translateX(18px); }
  .demo-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 14px; border-top: 1px solid var(--line); font-weight: 700; }
  .demo-total strong { font-size: 1.6rem; color: var(--forest-700); font-variant-numeric: tabular-nums; }
  .demo-total strong.bump { animation: bump 0.45s var(--ease); }
  @keyframes bump { 40% { transform: scale(1.07); color: var(--ochre-700); } }

  /* ---------- HAKKIMIZDA / NEDEN ---------- */
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; margin-bottom: clamp(72px, 9vw, 120px); }
  .about-media { position: relative; padding: 0 12% 18% 0; }
  .about-img-1 { width: 100%; border-radius: var(--radius-lg); aspect-ratio: 4/3; object-fit: cover; box-shadow: var(--shadow); }
  .about-img-2 { position: absolute; right: 0; bottom: 0; width: 52%; border-radius: var(--radius); aspect-ratio: 4/3; object-fit: cover; border: 6px solid var(--sand-50); box-shadow: var(--shadow-lg); }
  .about-badge { position: absolute; left: -12px; bottom: 8%; display: flex; align-items: center; gap: 12px; padding: 10px 18px 10px 10px; border-radius: 999px; background: var(--white); box-shadow: var(--shadow); }
  .about-badge img { width: 52px; height: 52px; border-radius: 50%; }
